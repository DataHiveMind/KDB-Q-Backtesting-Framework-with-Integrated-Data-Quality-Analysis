/ tests/q_unit/test_matching.q - Unit tests for vectorized LOB execution

system "l src/engine/matching.q"

assert: {[condition; message] if[not condition; '"Assertion Failed: ", message]};

show "Running Matching Engine Unit Tests...";

/ Mock historical clean quotes (the LOB state)
mock_quotes: ([] 
    time: 09:30:00.000 09:30:00.100 09:30:00.200; 
    sym: `AAPL`AAPL`AAPL; 
    bid: 150.0 150.1 150.2; 
    ask: 150.1 150.2 150.3; 
    bsize: 500 500 100; 
    asize: 500 100 500
 );

/ Mock strategy orders generated by Python ML model
mock_orders: ([] 
    time: 09:30:00.105 09:30:00.205; 
    sym: `AAPL`AAPL; 
    side: `buy`sell; 
    qty: 200 600
 );

/ Execute
executions: .match.executeMarketOrders[mock_orders; mock_quotes];

/ Verify Buy Order (aj should match to 09:30:00.100)
/ Should buy at the ask (150.2). Requested 200, available 100 -> Partial fill of 100, walked book.
buy_exec: first executions;
assert[buy_exec[`exec_price] = 150.2; "Buy order executed at wrong price"];
assert[buy_exec[`filled_qty] = 100; "Buy order filled qty incorrect for partial fill"];
assert[buy_exec[`walked_book]; "Walked book flag not set for partial fill"];

/ Verify Sell Order (aj should match to 09:30:00.200)
/ Should sell at the bid (150.2). Requested 600, available 100 -> Partial fill of 100.
sell_exec: last executions;
assert[sell_exec[`exec_price] = 150.2; "Sell order executed at wrong price"];
assert[sell_exec[`filled_qty] = 100; "Sell order filled qty incorrect"];

show "All Matching Engine Unit Tests Passed.";
exit 0;